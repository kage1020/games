{
  "name": "games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "game.kage1020.com — 登録なしで遊べる小さなゲームの遊び場",
  "scripts": {
    "dev": "cf dev",
    "build": "pnpm typecheck && cf build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "cf workers types && tsc -b",
    "tokens": "node scripts/build-tokens.ts",
    "og": "node scripts/build-og.ts",
    "cf:types": "cf workers types",
    "db:migrate:local": "cf d1 migrations apply ad24460e-af74-4904-9bea-7a4d904c4863 --local --persist-to .cloudflare/state",
    "db:migrate:remote": "cf d1 migrations apply ad24460e-af74-4904-9bea-7a4d904c4863",
    "deploy": "pnpm typecheck && cf deploy"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0",
  "dependencies": {
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "1.0.0-beta.17",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
